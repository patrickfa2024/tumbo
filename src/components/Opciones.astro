---
import Image from 'astro/components/Image.astro';
import 'swiper/css';
import 'swiper/css/pagination';
import nocturnas from "../assets/img/nocturna.png";
import precios from "../assets/img/precios.png";
import verano from "../assets/img/verano.png";
import ingles from "../assets/img/ingles.png";
import colaciones from "../assets/img/colaciones.png";
---
<div class="swiperOpciones mt-8 mb-6">
    <div class="swiper-wrapper ml-5">
        <div class="swiper-slide">
            <Image src={nocturnas} alt="nocturnas" height="120"  />
            <p class="text-sm ml-6">Venta Nocturna</p>
        </div>
        <div class="swiper-slide">
            <Image src={precios} alt="precios" height="120"  />
            <p class="text-sm ml-6">precios excelentes</p>
        </div>
        <div class="swiper-slide">
            <Image src={verano} alt="verano" height="120" />
            <p class="text-sm ml-6">Verano</p>
        </div>
        <div class="swiper-slide">
            <Image src={ingles} alt="ingles" height="120"  />
            <p class="text-sm ml-6">corte ingles</p>
        </div>
        <div class="swiper-slide">
            <Image src={colaciones} alt="colaciones" height="120"  />
            <p class="text-sm ml-6">Colaciones</p>
        </div>
    </div>
    
    <div class="swiper-pagination"></div>
</div>

<script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  
    const swiper = new Swiper('.swiperOpciones', {
      modules: [Navigation, Pagination],
      slidesPerView: 3,
      spaceBetween: 20,
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        768: {
          slidesPerView: 3,
        },
        1024: {
          slidesPerView: 4,
        }
      },
    });
  </script>
  
  <style>
    .swiper {
      width: 100%;
      padding: 20px;
    }
  
    .swiper-slide {
      height: auto;
    }
  </style>