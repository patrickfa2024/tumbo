---
import Image from 'astro/components/Image.astro';
import Card from '../components/Card.astro';
import 'swiper/css';
import 'swiper/css/pagination';
import ofertas from '../assets/img/ofertas.png';
import Opciones from '../components/Opciones.astro';
import oferton from '../assets/img/oferton.png';
import martes from  '../assets/img/martes.png';
---
<Image src={ofertas} alt="ofertas"  class="h-14" />

<Opciones />

<Image src={oferton} alt="oferton" height="250" class="rounded-2xl px-2" />

<main class="flex flex-col">
    <div class="swiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <Card />
            </div>
            <div class="swiper-slide">
                <Card />
            </div>
            <div class="swiper-slide">
                <Card />
            </div>
            <div class="swiper-slide">
                <Card />
            </div>
            <div class="swiper-slide">
                <Card />
            </div>
            <div class="swiper-slide">
                <Card />
            </div>
        </div>
        
        <div class="swiper-pagination"></div>
    </div>

<Image src={martes} alt="martes" class="mt-4" />

</main>


<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  const swiper = new Swiper('.swiper', {
    modules: [Navigation, Pagination, Autoplay],
    slidesPerView: 1,
    spaceBetween: 20,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    breakpoints: {
      640: {
        slidesPerView: 2,
      },
      768: {
        slidesPerView: 3,
      },
      1024: {
        slidesPerView: 4,
      }
    },
    pagination: {
      el: '.swiper-pagination',
      dynamicBullets: true
    }
  });
</script>

<style>
  .swiper {
    width: 100%;
    padding: 20px;
  }

  .swiper-slide {
    height: auto;
  }

  :global(.swiper-pagination-bullet) {
    background: #0d8002;
    width: 13px;
    height: 13px;
  }
</style>